# Copy to apps/cms/.env and apps/mcp-server/.env as needed.
# Ports: 5432 Postgres, 3000 web (Fumadocs), 3001 cms, 5173 open-slide demo. MCP is stdio-only (no TCP port).

DATABASE_URI=postgres://tablecontent:tablecontent@127.0.0.1:5432/tablecontent
PAYLOAD_SECRET=change-me-in-dev-only
NEXT_PUBLIC_CMS_URL=http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
CMS_URL=http://localhost:3001
CMS_API_KEY=
VITE_CONTENT_API_URL=http://localhost:3001/api

# --- Regenerate Payload artifacts (from repo root: `pnpm generate:cms`) ---
# Requires Postgres reachable at DATABASE_URI (e.g. `docker compose up -d postgres`).
# Writes: apps/cms/src/payload-types.ts, apps/cms/src/app/(payload)/admin/importMap.js
# Optional: same DATABASE_URI + PAYLOAD_SECRET in the shell when you run the commands.

# --- Throwaway Payload app (create-payload-app) ---
# Must pass --db and --db-accept-recommended (or --db-connection-string) or the CLI hangs on prompts.
# See docs/scaffold-payload-blank.md and: pnpm scaffold:payload

# --- kind-viewer (apps/kind-viewer) — optional AI slide layout ---
# Without these, layout optimize uses offline heuristics only.
# KIND_LAYOUT_AI_API_KEY=
# KIND_LAYOUT_AI_BASE_URL=https://api.openai.com/v1
# KIND_LAYOUT_AI_MODEL=gpt-4o-mini
# Or reuse OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL

# --- docx studio self-hosted deploy (docker-compose.docx-studio.yml) ---
# Shared access token — REQUIRED before exposing the API publicly. When unset,
# the API is open (local dev only) and the server logs a warning.
# DOCX_STUDIO_TOKEN=change-me-long-random-string
# DOCX_STUDIO_RATE_LIMIT=120          # requests/min/IP
# DOCX_STUDIO_MAX_BODY=31457280       # bytes (30MB) request body cap
# DOCX_STUDIO_MAX_BODY_HUMAN=30MB     # same cap, Caddy edge form
# DOCX_STUDIO_ALLOW_HTML_WRITE=       # set to 1 to re-enable PUT /api/raw-html in prod
# Admin panel (/admin): password unlocks runtime LLM config; survives in a
# settings file on the docx_out volume and OVERRIDES the env LLM vars below.
# DOCX_STUDIO_ADMIN_PASSWORD=change-me-admin-password
# DOCX_STUDIO_ADMIN_TTL_MS=43200000   # admin session lifetime (12h)
# DOCX_STUDIO_SETTINGS_FILE=/repo/out/.studio/settings.json  # default; on docx_out volume
# Reverse proxy (--profile proxy): set a real domain for automatic HTTPS
# DOCX_STUDIO_DOMAIN=docx.example.com
# DOCX_STUDIO_TLS_EMAIL=admin@example.com
# DOCX_STUDIO_HTTP_PORT=80
# DOCX_STUDIO_HTTPS_PORT=443
# Render reliability + retention
# DOCX_BUILD_CONCURRENCY=1            # parallel LibreOffice renders
# DOCX_SOFFICE_TIMEOUT_MS=120000
# DOCX_PDFTOPPM_TIMEOUT_MS=60000
# DOCX_RETENTION_DAYS=14              # auto-delete out/documents/* older than this
# DOCX_CLEANUP_INTERVAL_SECONDS=86400

# --- docx-master (html-lab /docx + MCP + Docker studio) — LLM paste → Markdown ---
# Primary provider (OpenAI-compatible):
# DOCX_MASTER_AI_API_KEY=
# DOCX_MASTER_AI_BASE_URL=https://api.openai.com/v1
# DOCX_MASTER_AI_MODEL=gpt-4o-mini
# Fallback provider (tried if primary fails — e.g. DeepSeek, n1n.ai):
# DOCX_MASTER_AI_FALLBACK_API_KEY=
# DOCX_MASTER_AI_FALLBACK_BASE_URL=https://api.deepseek.com/v1
# DOCX_MASTER_AI_FALLBACK_MODEL=deepseek-chat
# Legacy tertiary:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# Explicit JSON provider chain (overrides prefixes when set):
# DOCX_MASTER_AI_PROVIDERS=[{"id":"openai","apiKey":"sk-...","baseUrl":"https://api.openai.com/v1","model":"gpt-4o-mini"}]
# NOTE: providers configured via the /admin panel take precedence over ALL of
# the above env vars (they are written to DOCX_STUDIO_SETTINGS_FILE).
# Docker: docker compose -f docker-compose.docx-studio.yml up -d --build  →  http://localhost:3333/docx
