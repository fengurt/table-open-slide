# slides.opcglobal.cn — server-side env. Copy to /opt/slides/.env on opc-hom-01.
# Generate the token with:  openssl rand -hex 24

# REQUIRED — Bearer token gating all /api/docx/* writes + library reads.
DOCX_STUDIO_TOKEN=change-me-long-random-string

# Optional — unlocks the /admin runtime LLM config panel.
DOCX_STUDIO_ADMIN_PASSWORD=change-me-admin-password

# Container loopback port fronted by host nginx (leave 3333 unless taken).
SLIDES_PORT=3333

# Retention sweep
DOCX_RETENTION_DAYS=30

# --- LLM (optional; prefer ./configure-tongyi.sh → /admin persisted settings) ---
# Tongyi Token Plan seat key (sk-sp-…) — NOT standard DashScope (sk-…):
# DOCX_MASTER_AI_API_KEY=
# DOCX_MASTER_AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DOCX_MASTER_AI_MODEL=qwen3.7-max
# DOCX_MASTER_AI_FALLBACK_API_KEY=
# DOCX_MASTER_AI_FALLBACK_BASE_URL=
# DOCX_MASTER_AI_FALLBACK_MODEL=
